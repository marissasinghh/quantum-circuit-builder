# Sample environment variables for local / Render setup.
# Copy to .env and fill in values. Never commit a real GITHUB_PAT.

SECRET_KEY=dev_secret_key
ALLOWED_ORIGINS=http://localhost:5173
API_VERSION=v1
MONGO_URI=

# Fine-grained PAT with Issues read/write on the target repo only
GITHUB_PAT=
GITHUB_REPO=marissasinghh/quantum-circuit-builder
